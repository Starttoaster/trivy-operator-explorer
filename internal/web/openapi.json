        "type": "object",
        "required": ["repository", "tag", "cve_ids", "reason"],
        "properties": {
          "registry": { "type": "string", "description": "Defaults to index.docker.io when empty." },
          "repository": { "type": "string" },
          "tag": { "type": "string" },
          "cve_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "reason": { "type": "string" }
        }
      },
      "IgnoresInsertResponse": {
        "type": "object",
        "required": ["inserted"],
        "properties": {
          "inserted": { "type": "integer", "description": "Number of rows actually inserted. Already-ignored CVEs are skipped and not counted." }
        }
      },
      "IgnoresDeleteRequest": {
        "type": "object",
        "required": ["repository", "tag", "cve_ids"],
        "properties": {
          "registry": { "type": "string", "description": "Defaults to index.docker.io when empty." },
          "repository": { "type": "string" },
          "tag": { "type": "string" },
          "cve_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        }
      },
      "IgnoresDeleteResponse": {
        "type": "object",
        "required": ["deleted"],
        "properties": {
          "deleted": { "type": "integer", "description": "Number of rows actually deleted. Non-existent rows are silently skipped." }
        }
      }
    }
  }
